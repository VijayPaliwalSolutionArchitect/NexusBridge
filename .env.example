# NexusBridge — environment configuration template.
# Copy to .env (project root) and adjust. Never commit real secrets.
# .gitignore already excludes .env and .env.* (except this .env.example).

# --- Storage ---------------------------------------------------------------
# Directory for runtime artifacts (SQLite database).
# Default: <project root>/data
# NEXUSBRIDGE_DATA_DIR=C:/Vijay-Projects/NexusBridge/data

# SQLite database file path. Use :memory: for ephemeral runs/tests.
# Default: <NEXUSBRIDGE_DATA_DIR>/nexusbridge.db
# NEXUSBRIDGE_DB_PATH=C:/Vijay-Projects/NexusBridge/data/nexusbridge.db

# --- Web workspace ---------------------------------------------------------
# Directory served as the static frontend at "/".
# Default: <project root>/frontend
# NEXUSBRIDGE_FRONTEND_DIR=C:/Vijay-Projects/NexusBridge/frontend

# --- Server ----------------------------------------------------------------
# Bind host / port for uvicorn.
# Defaults: 0.0.0.0 / 8000
# NEXUSBRIDGE_HOST=0.0.0.0
# NEXUSBRIDGE_PORT=8000

# NOTE: NexusBridge is a reference implementation — it intentionally has no
# secret-bearing variables (no API keys, tokens, or credentials are read or
# stored). Production equivalents would live here as placeholders, e.g.:
# AZURE_CLIENT_ID=your-entra-app-client-id
# AZURE_CLIENT_SECRET=your-entra-app-client-secret   # [REDACTED] in real use
